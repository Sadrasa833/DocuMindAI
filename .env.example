# ---------------------------------------------------------------------------
# DocuMind AI — environment configuration
# Copy this file to `.env` and replace every placeholder before starting.
# Never commit `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-with-at-least-32-random-characters-before-use

# OpenAI is required for embeddings, RAG answers, and summaries.
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column/index dimension in the initial migration.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
OPENAI_TIMEOUT_SECONDS=60

# Local (non-Docker) database. Docker Compose overrides the host to `postgres`.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_PORT=6379

# Comma-separated list. Wildcards are rejected because credentials are enabled.
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refreshes racing within this window retry instead of ending the session family.
REFRESH_REUSE_GRACE_SECONDS=30
# Cookies are HttpOnly and SameSite=Lax by default.
# COOKIE_SECURE must be true when ENVIRONMENT=production and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

MAX_UPLOAD_SIZE_MB=20
USER_STORAGE_QUOTA_MB=1024
# STORAGE_BACKEND=local uses STORAGE_PATH. Use s3 for S3-compatible object storage.
STORAGE_BACKEND=local
STORAGE_PATH=data/uploads
# S3-compatible storage (AWS S3, MinIO, etc.). S3_BUCKET is required when STORAGE_BACKEND=s3.
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY must be set together; omit both to use the AWS credential chain.
S3_BUCKET=
S3_PREFIX=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true
# Optional ClamAV INSTREAM scanning. Uploads fail closed when enabled and the scanner is unavailable.
MALWARE_SCANNING_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
PROCESSING_STUCK_AFTER_SECONDS=1800
PROCESSING_RECOVERY_INTERVAL_SECONDS=300
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# OCR runs only for pages without selectable text. Persian uses the `fas` pack.
OCR_ENABLED=true
OCR_LANGUAGES=eng+fas
OCR_DPI=200
OCR_MAX_PAGES=50
OCR_TIMEOUT_SECONDS=30
SEARCH_DEFAULT_TOP_K=5
SEARCH_MIN_SIMILARITY=0.2
RAG_MAX_CONTEXT_CHUNKS=8
RAG_HISTORY_MESSAGES=8
# Claim-level citation validation. Semantic checking adds one batched embedding call per answer.
RAG_CITATION_VALIDATION_ENABLED=true
RAG_CITATION_MIN_SUPPORT=0.55
RAG_CITATION_REQUIRE_CITATIONS=true
RAG_CITATION_SEMANTIC_CHECK=false
RAG_CITATION_SEMANTIC_THRESHOLD=0.45
SUMMARY_MAP_CHUNK_CHARS=12000
SUMMARY_REDUCE_CHUNK_CHARS=20000
SUMMARY_MAX_TOKENS=1200

RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=20
SEARCH_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Docker Compose host ports.
BACKEND_PORT=8000
FRONTEND_PORT=3000
FLOWER_PORT=5555
